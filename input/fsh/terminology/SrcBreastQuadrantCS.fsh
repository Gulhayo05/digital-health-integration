CodeSystem: SrcBreastQuadrantCS
Id: src-breast-quadrant-cs
Title: "Breast Quadrant CodeSystem"
Description: "Локальный справочник квадрантов молочной железы для локализации находок"
* insert OriginalCodeSystem(src-breast-quadrant-cs)

* #src-breast-quadrant-1 "UI (Upper Inner)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Верхне-внутренний"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Yuqori ichki"

* #src-breast-quadrant-2 "UE (Upper External)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Верхне-наружный"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Yuqori tashqi"

* #src-breast-quadrant-3 "LI (Lower Inner)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Нижне-внутренний"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Pastki ichki"

* #src-breast-quadrant-4 "LE (Lower External)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Нижне-наружный"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Pastki tashqi"

* #src-breast-quadrant-5 "C (Central)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Центральный"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Markaziy"

* #src-breast-quadrant-6 "AX (Axillary)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Подмышечный"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Qo'ltiq osti"